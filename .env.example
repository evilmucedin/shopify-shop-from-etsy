# Server
PORT=3000

# Optional: lock the app to a single operator's credentials instead of
# entering them in the UI. If unset, users provide credentials in the app.

# Etsy (read side) — Open API v3 personal/app token with listings_r scope
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=

# Shopify (write side) — custom app Admin API access token (shpat_...)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
